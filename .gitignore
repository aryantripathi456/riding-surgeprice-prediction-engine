# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Data contents (tracked by DVC, not git) - but NOT .dvc files
/data/raw/*
!/data/raw/*.dvc
/data/processed/*
!/data/processed/*.dvc
/data/features/*
!/data/features/*.dvc

# Model artifacts (tracked by DVC)
/models/*.pkl
/models/*.joblib
/models/*.pt
!/models/*.dvc

# Reports (generated)
/reports/drift/*.html
/reports/*.csv
/reports/*.json

# DVC internals
.dvc/cache/
.dvc/tmp/
*.dvc.lock

# Environment variables
.env
.env.local

# Docker
docker-compose.override.yml

# Local documentation (not for repo)
GITHUB.md
ERRORS.md
